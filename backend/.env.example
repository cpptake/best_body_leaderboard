# Flask環境設定
FLASK_ENV=development
PORT=5000

# OpenAI API設定
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_TIMEOUT=120.0
# OPENAI_MAX_RETRIES=2
# OPENAI_MODEL=gpt-4-turbo
# OPENAI_MAX_TOKENS=1000
# OPENAI_TEMPERATURE=0

# CORS設定（カンマ区切りで複数のオリジンを指定可能）
CORS_ORIGINS=http://localhost:3000

# データベース接続URL
DATABASE_URL=postgresql://bodybuilder:password@db:5432/bodybuilder_db

# データベース接続プール設定（オプション）
# DB_POOL_SIZE=10
# DB_POOL_RECYCLE=3600
# DB_POOL_PRE_PING=True

# AWS S3設定
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=bestbody-leaderboard
AWS_REGION=ap-northeast-1
S3_BASELINE_IMAGE_KEY=baseline/baseline.jpg
S3_SUBMIT_IMAGE_KEY=submit-image/
# S3_URL_EXPIRATION=3600

# 画像処理設定（オプション）
# MAX_IMAGE_SIZE=10485760
# MAX_IMAGE_DIMENSION=1920
# JPEG_QUALITY=85

# バリデーション設定（オプション）
# USERNAME_MIN_LENGTH=1
# USERNAME_MAX_LENGTH=50

# ページネーション設定（オプション）
# LEADERBOARD_PER_PAGE=20
# LEADERBOARD_MAX_PER_PAGE=100

# ロギング設定（オプション）
# DEBUG_CONTENT_MAX_LENGTH=200
